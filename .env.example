# =============================================================================
# Life Tracker — 環境變數樣板
# =============================================================================
# 用法：複製此檔為 .env.local 後填入實際值（.env.local 已被 gitignore）。
#   cp .env.example .env.local
# NEXT_PUBLIC_ 前綴的變數會被打包進 client-side JS（公開可見），其餘僅在
# server-side（如 app/api/upload/route.js）使用。
# =============================================================================

# --- Supabase（必填）---------------------------------------------------------
# Supabase 專案 Settings → API 取得。anon key 為公開金鑰，靠 RLS 保護資料。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Google Cloud Storage 憑證（必填）----------------------------------------
# 來源：GCP service account 的 JSON 金鑰檔，抄出以下三個欄位。
# GCP_PRIVATE_KEY 需整段用雙引號包住，並保留字面上的 \n（程式會還原換行）：
#   GCP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"
GCP_PROJECT_ID=
GCP_CLIENT_EMAIL=
GCP_PRIVATE_KEY=

# --- Google Cloud Storage bucket 名稱（選填）---------------------------------
# 不填則使用程式內建預設值（見 app/api/upload/route.js）。
GCP_BUCKET_NAME=cholate-thumbnail
GCP_GALLERY_BUCKET_NAME=cholate-gallery
